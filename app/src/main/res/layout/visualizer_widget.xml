<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Source Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_source"
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_source_internal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_phone"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/content_desc_internal_source" />

        <ImageButton
            android:id="@+id/btn_source_mic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_mic"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/content_desc_mic_source" />

        <ImageButton
            android:id="@+id/btn_source_viz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_graphic_eq"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/content_desc_visualizer_source" />
    </LinearLayout>

    <!-- Output Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_output"
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_viz_haptics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_vibration"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/content_desc_toggle_haptics" />

        <ImageButton
            android:id="@+id/btn_viz_glyphs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_nav_glyphs"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/content_desc_toggle_glyphs" />

        <ImageButton
            android:id="@+id/btn_viz_torch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_flashlight"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/content_desc_toggle_torch" />
    </LinearLayout>

    <!-- Start/Stop Button -->
    <ImageButton
        android:id="@+id/btn_start_stop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button_bg"
        android:src="@drawable/ic_play"
        android:scaleType="centerInside"
        android:contentDescription="@string/content_desc_start_stop" />

</LinearLayout>
