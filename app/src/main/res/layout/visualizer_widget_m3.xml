<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m3_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Source Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <ImageButton
            android:id="@+id/btn_source_internal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_phone"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Internal Source" />

        <ImageButton
            android:id="@+id/btn_source_mic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_mic"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Mic Source" />

        <ImageButton
            android:id="@+id/btn_source_viz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_graphic_eq"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Visualizer Source" />
    </LinearLayout>

    <!-- Output Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginVertical="4dp">

        <ImageButton
            android:id="@+id/btn_viz_haptics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_vibration"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Toggle Haptics" />

        <ImageButton
            android:id="@+id/btn_viz_glyphs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_nav_glyphs"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Toggle Glyphs" />

        <ImageButton
            android:id="@+id/btn_viz_torch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_flashlight"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Toggle Torch" />
    </LinearLayout>

    <!-- Start/Stop Button (Spans 3 squares) -->
    <LinearLayout
        android:id="@+id/btn_start_stop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_m3_button_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/img_start_stop"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_play"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/txt_start_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="START BNMV"
            android:textColor="@color/widget_m3_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
