<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m3_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Source Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_m3_button_bg_selected"
            android:src="@drawable/ic_phone"
            android:tint="@android:color/white"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_mic"
            android:tint="@color/widget_m3_on_surface"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_graphic_eq"
            android:tint="@color/widget_m3_on_surface"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Output Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginVertical="4dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_vibration"
            android:tint="@color/widget_m3_on_surface"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_m3_button_bg_selected"
            android:src="@drawable/ic_qs_tile"
            android:tint="@android:color/white"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_m3_button_bg"
            android:src="@drawable/ic_flashlight"
            android:tint="@color/widget_m3_on_surface"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Start/Stop Button (Spans 3 squares) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_m3_button_bg_selected"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_stop"
            android:tint="@android:color/white"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/widget_stop_bnmv"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
