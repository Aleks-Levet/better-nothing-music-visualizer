    <!-- Audio Help Guides -->
    <string name="help_source_intro">Choisir où capturer l\'audio pour la visualisation :</string>
    <string name="help_source_internal_title">Audio interne</string>
    <string name="help_source_internal_desc">Capture un son de haute qualité directement depuis vos applications. Le popup \"partage d\'écran\" est ce dont Android a besoin pour permettre la capture audio par BNMV. Il n\'enregistre pas votre écran et est très économe en batterie. </string>
    <string name="help_source_mic_title">Microphone</string>
    <string name="help_source_mic_desc">Analyse le son de l\'environnement. Utile pour les fêtes où vous ne mettez pas le son vous-même.</string>
    <string name="help_source_network_title">Autre appareil ou application...</string>
    <string name="help_source_network_desc">Reçoit des données audio d\'un autre appareil qui diffuse des données audio avec cette application.</string>
    <string name="help_source_viz_title">Visualiseur Android standard</string>
    <string name="help_source_viz_desc">C\'est ce qu\'Android permet officiellement aux applications de visualiseur d\'utiliser, un flux audio de très faible qualité. Il ne demande pas les autorisations de partage d\'écran, mais c\'est de la merde.</string>
    <string name="help_source_privacy">N’oubliez pas, aucune donnée audio n’est jamais enregistrée ou stockée sur votre appareil.</string>
    <string name="help_output_intro">Contrôle où la visualisation s\'affiche:</string>
    <string name="help_output_glyphs_desc">Visualise l\'audio à l\'aide des LEDs Glyph Interface / Matrice.</string>
    <string name="help_output_haptics_desc">Vous permet de ressentir la musique à travers le moteur de vibration haptique.</string>
    <string name="help_output_flash_desc">Synchronise votre flash avec la musique !</string>
    <string name="help_output_broadcast_title">\"Permettre à d\'autres appareils de se connecter...\"</string>
    <string name="help_output_broadcast_desc">Diffuse les données audio vers d\'autres appareils de votre réseau utilisant BNMV pour pouvoir les synchroniser ensemble. Essayez, c\'est cool !</string>
    <string name="help_sync_title">Connexion à un autre appareil :</string>
    <string name="help_sync_step1">1. Activez \'Laisser d\'autres appareils se connecter...\' sur l\'appareil qui diffuse la musique (Source).</string>
    <string name="help_sync_step2">2. Sur cet appareil, sélectionnez « Autre appareil ou application » comme Source Audio et choisissez le périphérique source dans la liste.</string>
