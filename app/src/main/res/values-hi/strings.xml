    <!-- Audio Help Guides -->
    <string name="help_source_intro">Choose where to capture audio for visualization:</string>
    <string name="help_source_internal_title">Media projection</string>
    <string name="help_source_internal_desc">Captures high-quality audio directly from your apps. The \"screen share\" popup is what android needs to allow audio capture by BNMV. It does not record your screen and is highly battery efficient. </string>
    <string name="help_source_mic_title">Microphone</string>
    <string name="help_source_mic_desc">Captures sound from the environment. Useful for parties where you do not play the songs yourself.</string>
    <string name="help_source_network_title">Another device or app...</string>
    <string name="help_source_network_desc">Receives audio data from another device that is broadcasting audio data with this app.</string>
    <string name="help_source_viz_title">Android built in Visualizer</string>
    <string name="help_source_viz_desc">This is what android officially lets visualizer apps use, a very low quality audio stream. It doesn\'t ask for screen sharing permissions tho.</string>
    <string name="help_source_privacy">Remember, no audio data is ever saved or stored on your device.</string>
    <string name="help_output_intro">Control where the visualization appears:</string>
    <string name="help_output_glyphs_desc">Visualizes audio using the Glyph Interface / Matrix LEDs.</string>
    <string name="help_output_haptics_desc">Lets you feel the music through the haptic vibration motor.</string>
    <string name="help_output_flash_desc">Pulses the camera flashlight to the beat.</string>
    <string name="help_output_broadcast_title">\"Let other devices connect...\"</string>
    <string name="help_output_broadcast_desc">Streams audio data to other devices on your network.</string>
    <string name="help_sync_title">Connecting to another device:</string>
    <string name="help_sync_step1">1. Enable \'Let other devices connect...\' on the device playing music (Source).</string>
    <string name="help_sync_step2">2. On this device, select \'Another device or app...\' as the Audio Source and pick the source device from the list.</string>
