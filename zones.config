  "np2-fractal": {
    "preset_name": "Fractal",
    "description": "The full 20Hz-18kHz spectrum is read four times at once, at four different resolutions, on four different parts of the phone: the ring is a fine 16-band analyzer, the side arcs are a coarse 5-band analyzer, the battery bar is a medium 8-band analyzer, and the camera arcs/glyph/dot are four ultra-narrow probes pinned to specific musically important points (sub, kick, vocal presence, air). Every single zone is still unique -- the same spectral event registers differently across scales simultaneously, self-similar at every level, like a fractal.  MADE BY @IJS",
    "phone_model": "PHONE2",
    "decay-alpha": 0.65,
    "zones": [
      [20, 35, "Probe: true sub (A1)"],
      [55, 70, "Probe: kick fundamental (A2)"],
