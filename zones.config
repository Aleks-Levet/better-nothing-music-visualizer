  "np2-counterpoint": {
    "preset_name": "Counterpoint",
    "description": "Four independent voices instead of one sweep. The ring's odd segments (1,3,5...) climb low-to-high; its even segments (2,4,6...) climb high-to-low over the same physical space -- two contrary melodic lines interleaved around one ring, like a musical round. The 5 side arcs carry a separate, deliberately non-monotonic countermelody that jumps up-down-up-down-up. Top camera arc + dot anchor a steady low voice, the bottom camera arc bridges the middle register, and the essential glyph anchors a high voice. Every zone unique, but the STRUCTURE -- not just the spectrum -- is the twist.  MADE BY @IJS",
    "phone_model": "PHONE2",
    "decay-alpha": 0.7,
    "zones": [
      [40, 65, "Low voice (foundation) (A1)"],
